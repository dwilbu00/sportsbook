# Streamlit secrets template — copy to `.streamlit/secrets.toml` and fill in.
# The real secrets.toml is gitignored; only this example is committed.

# The Odds API key (https://the-odds-api.com/). Required for live odds.
ODDS_API_KEY = "your-odds-api-key"

# ── Azure SQL durable-state backend ───────────────────────────────────────────
# The durable store for all app state (prediction log, wagers ledger,
# recalibration params, odds warehouse). Set all four keys for durable storage;
# without them the app falls back to an EPHEMERAL local cache (dev/test only —
# state is lost on redeploy). Connect as the least-privilege app user (CRUD only)
# — NOT the server admin. Tables are created manually by the admin from
# sql/schema.sql before first use.
# SQL_SERVER   = "sportsbookstreamlitdb.database.windows.net"
# SQL_DATABASE = "sportsbook_value_finder_db"
# SQL_USER     = "StreamlitApp"
# SQL_PASSWORD = "your-streamlitapp-password"
