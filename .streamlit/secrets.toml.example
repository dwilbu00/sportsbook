# Streamlit secrets template — copy to `.streamlit/secrets.toml` and fill in.
# The real secrets.toml is gitignored; only this example is committed.

# The Odds API key (https://the-odds-api.com/). Required for live odds.
ODDS_API_KEY = "your-odds-api-key"

# Azure Blob container SAS URL for the legacy durable store (prediction log,
# wagers ledger, recalibration params, odds warehouse). Used ONLY when the
# SQL_* keys below are NOT set. Container-scoped (sr=c), token in the query.
# PREDICTION_LOG_BLOB_URL = "https://<account>.blob.core.windows.net/<container>/prediction_log.jsonl?<sas-token>"

# ── Azure SQL durable-state backend (preferred; overrides Blob when all four
# are set) ──────────────────────────────────────────────────────────────────
# Connect as the least-privilege app user (CRUD only) — NOT the server admin.
# Tables are created manually by the admin from sql/schema.sql before first use.
# SQL_SERVER   = "sportsbookstreamlitdb.database.windows.net"
# SQL_DATABASE = "sportsbook_value_finder_db"
# SQL_USER     = "StreamlitApp"
# SQL_PASSWORD = "your-streamlitapp-password"
