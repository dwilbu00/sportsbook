# Python
__pycache__/
*.pyc
*.pyo

# Editor swap files
.*.swp
.*.swo

# Streamlit secrets (only the example is committed)
.streamlit/secrets.toml

# Local runtime config holding the API key (only config.json.example is committed)
config.json

# Runtime caches and logs (populated by the app at run time, not source)
cache/

# Local odds-warehouse fallback (durable copy lives in Azure Blob at run time)
warehouse/

# Local-only sql scripts
clear_tables.sql

# Web resources for Claude
.webresources